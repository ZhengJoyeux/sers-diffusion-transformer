+
+    quantiles = np.quantile(
+        generated,
+        [0.05, 0.25, 0.50, 0.75, 0.95],
+        axis=0,
+    )
+    q05, q25, generated_median, q75, q95 = quantiles
+    training_median = np.median(training, axis=0)
+    reference_median = np.median(reference, axis=0)
