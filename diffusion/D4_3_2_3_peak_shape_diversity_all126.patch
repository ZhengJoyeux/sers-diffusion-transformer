+        prominence=relative_prominence * peak_maximum,
+        distance=distance_points,
+    )
+    edge_points = int(np.ceil(edge_exclusion / spacing))
+    keep = np.logical_and(peaks >= edge_points, peaks < axis.size - edge_points)
