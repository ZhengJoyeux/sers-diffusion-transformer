+        condition=condition,
+        prior_conditioning=prior,
+    )
+    assert torch.isfinite(loss)
+    loss.backward()
+    assert any(
+        parameter.grad is not None and torch.isfinite(parameter.grad).all()
+        for parameter in diffusion.parameters()
+    )
